SECRET_KEY=replace-with-a-long-random-secret-before-running
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stockflow
MYSQL_USER=stockflow_app
MYSQL_PASSWORD=
CORS_ORIGINS=http://localhost:5173
TOKEN_MAX_AGE=43200

# Optional seed passwords. Existing accounts are never changed.
# Prefer separate passwords for the initial administrator and staff account.
INITIAL_ADMIN_PASSWORD=
INITIAL_STAFF_PASSWORD=
# Optional compatibility shortcut: also creates the demo customer and is used
# as a fallback for Admin/Staff only when their separate password is blank.
DEMO_PASSWORD=
DEMO_ADMIN_EMAIL=admin@stockflow.local
DEMO_STAFF_EMAIL=staff@stockflow.local
DEMO_CUSTOMER_EMAIL=customer@stockflow.local